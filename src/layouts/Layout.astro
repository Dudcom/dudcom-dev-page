---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/typography.css"
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/typography-tables.css"
import "@/styles/typography-math.css"
import "@/styles/callout.css"
import "@/styles/comet.css"
import "@/styles/layout.css"
import "@/styles/icon-button.css"
import "@/styles/bar.css"
import "@/styles/shape.css"

import Footer from "@/components/Footer.astro"
import MetaHead from "@/components/MetaHead.astro"
import Sidebar from "@/components/Sidebar.astro"
import { SITE } from "@/consts"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs } = Astro.props
---

<html lang={SITE.locale} dir={SITE.dir}>
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body>
    <page-grid>
      <div class="comets" aria-hidden="true"></div>
      <page-header>
        <page-nav>
          <Sidebar crumbs={crumbs}
            ><slot name="actions" slot="actions" /></Sidebar
          >
        </page-nav>
        {Astro.slots.has("toc") && (
            <page-toc><slot name="toc" /></page-toc>
          )}
      </page-header>
      <page-content>
        <main><slot /></main>
        <page-footer><Footer /></page-footer>
      </page-content>
    </page-grid>
    <script is:inline>
      const comets = () => {
        const container = document.querySelector(".comets")
        if (!container) return

        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const el = document.createElement("div")
          el.className = "comet"
          el.style.opacity = "0.35"
          el.style.rotate = "16deg"
          el.style.translate = "62vw 20vh"
          container.appendChild(el)
          return
        }

        const makeComet = () => {
          const el = document.createElement("div")
          el.className = "comet"
          container.appendChild(el)
          const angle = 10 + Math.random() * 16
          const peak = 0.3 + Math.random() * 0.25
          const x0 = -14 - Math.random() * 6
          const y0 = Math.random() * 80
          const x1 = 112 + Math.random() * 10
          const slope = Math.tan((angle * Math.PI) / 180)
          const y1 = y0 + slope * (x1 - x0) * (innerWidth / innerHeight)
          el.style.rotate = `${angle}deg`
          return {
            el,
            start: performance.now(),
            duration: 2200 + Math.random() * 1400,
            peak,
            x0,
            y0,
            x1,
            y1,
          }
        }

        const active = []
        let nextBatch = performance.now() + 14000 + Math.random() * 8000
        const MIN_GAP = 9

        const spawnBatch = () => {
          const count = 1 + Math.floor(Math.random() * 10)
          const lanes = []
          for (let i = 0; i < count; i++) {
            let y = null
            for (let attempt = 0; attempt < 50; attempt++) {
              const candidate = Math.random() * 80
              if (
                lanes.every((lane) => Math.abs(lane - candidate) >= MIN_GAP)
              ) {
                y = candidate
                break
              }
            }
            if (y === null) continue
            lanes.push(y)
            const comet = makeComet()
            comet.y0 = y
            comet.y1 =
              y +
              Math.tan(((10 + Math.random() * 16) * Math.PI) / 180) *
                (comet.x1 - comet.x0) *
                (innerWidth / innerHeight)
            active.push(comet)
          }
        }

        const tick = (time) => {
          if (time >= nextBatch) {
            spawnBatch()
            nextBatch = time + 14000 + Math.random() * 8000
          }
          for (let i = active.length - 1; i >= 0; i--) {
            const c = active[i]
            const phase = time - c.start
            if (phase > c.duration) {
              c.el.remove()
              active.splice(i, 1)
              continue
            }
            const p = phase / c.duration
            const fadeIn = 0.15
            const fadeOut = 0.7
            const opacity =
              p < fadeIn
                ? (c.peak * p) / fadeIn
                : p > fadeOut
                  ? Math.max((c.peak * (1 - p)) / (1 - fadeOut), 0)
                  : c.peak
            const x = c.x0 + (c.x1 - c.x0) * p
            const y = c.y0 + (c.y1 - c.y0) * p
            c.el.style.opacity = String(opacity)
            c.el.style.translate = `${x}vw ${y}vh`
          }
          requestAnimationFrame(tick)
        }
        requestAnimationFrame(tick)
      }
      comets()
    </script>
  </body>
</html>

<style>
  page-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    gap: var(--grid-gutter);
    max-width: var(--grid-max-width);
    min-height: 100svh;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block-start: var(--page-offset-top);

    @media (width < 64rem) {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      padding-block-start: 0;
    }
  }

  page-header {
    display: contents;

    @media (width < 64rem) {
      display: block;
      grid-column: 1 / -1;
      position: sticky;
      top: 0;
      z-index: 10;
      min-width: 0;
      margin-inline: calc(-1 * var(--grid-gutter));
    }
  }

  page-nav {
    display: block;
    min-width: 0;
    grid-column: 1 / 3;
    grid-row: 1;

    @media screen and (width >= 64rem) {
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-start: var(--grid-edge);
      width: calc(2 * var(--grid-column-width) + var(--grid-gutter));
    }
  }

  page-toc {
    display: block;
    min-width: 0;
    grid-column: 10 / 13;
    grid-row: 1;

    @media screen and (width >= 64rem) {
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-end: var(--grid-edge);
      width: calc(3 * var(--grid-column-width) + 2 * var(--grid-gutter));
    }
  }

  page-content {
    display: flex;
    flex-direction: column;
    grid-column: 3 / 10;
    grid-row: 1;
    min-width: 0;
    margin-block-start: -0.1em;

    main {
      flex: 1;
    }

    page-footer {
      display: block;
      margin-block-start: var(--space-xl);
    }

    @media (width < 64rem) {
      grid-column: 1 / -1;
      grid-row: auto;
      inline-size: 100%;
      max-inline-size: var(--measure);
      margin-inline: auto;
    }
  }
</style>
