---
import AuthorCard from "@/components/AuthorCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"

const author = (await getCollection("authors")).find(
  (entry) => entry.id === "dudcom",
)

if (!author) throw new Error("The profile author is missing")
---

<Layout>
  <MetaPage slot="head" description={author.data.bio} />
  <header>
    <ul>
      <AuthorCard author={author} />
    </ul>
  </header>

  <section>
    <h2>whoami</h2>
    <p>
      Hello, nerds! Nice to meet you. If you are reading this for the first time
      and we have never met, it is a pleasure to meet you. I am Dudcom (Tanush),
      just another person interested in computer science, cybersecurity, AI,
      English football, F1, and occasionally touching grass. This website is
      where I share my thoughts on, well, really anything. If you have ever met
      me, you know I am rather chatty. I held off on making this for some time,
      but decided to finally bite the bullet. Hopefully, you gain something from
      my opinions and writing.
    </p>
    <p>
      I imagine this will be a mix of the technical work I do, random opinions
      and thoughts I have, as well as some fun content whenever I get a bit
      bored. If you ever want to contact me or chat, Dudcom is my Discord handle
      and probably the best way to reach me!
    </p>
  </section>
</Layout>

<style>
  header {
    margin-block-end: var(--space-l);
  }

  section {
    h2 {
      margin-block-end: var(--space-s);
      font-size: var(--step-1);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    > p {
      color: var(--muted-foreground);

      & + p {
        margin-block-start: 1em;
      }
    }
  }
</style>
